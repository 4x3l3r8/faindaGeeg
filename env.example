# ---------------------------------------------------------------------------
# Tech Opportunity Intelligence System (faindaGeeg)
# Copy this file to `.env` and fill in values as needed:
#   cp env.example .env
# ---------------------------------------------------------------------------

# --- Database (matches the `db` service in docker-compose.yml) ---
DATABASE_URL=postgresql://faindageeg:faindageeg@localhost:5432/faindageeg

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
# Optional single-user guard. Leave blank to run open (no auth).
API_AUTH_TOKEN=

# --- Web ---
WEB_PORT=5173
# Base URL the dashboard uses to reach the API. Vite exposes VITE_* vars to the
# client; the web app falls back to this value when unset.
VITE_API_BASE_URL=http://localhost:3001

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
# Apply any unapplied database migrations automatically when the API starts.
# Default true. Set to false (or 0) to manage migrations manually (e.g. in prod).
DB_AUTO_MIGRATE=true

# --- AI / LLM (Phase 1) ---
AI_PROVIDER=openrouter
# Leave blank for now; not required until Phase 1.
OPENROUTER_API_KEY=
# Cheap default model id.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Embeddings provider (Phase 4): local | openai | huggingface. Leave blank
# (default) to use the built-in local hashing embedder, which needs no API key
# and works fully offline. Switching providers requires re-embedding existing
# records.
EMBEDDINGS_PROVIDER=
# Vector dimension for the local embedder, and optionally for OpenAI
# (text-embedding-3-* support output truncation). Blank uses the built-in
# default (256). Switching dimensions requires re-embedding existing records.
EMBEDDING_DIM=
# Optional. Enables higher-quality embeddings via OpenAI. Only used when
# EMBEDDINGS_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# Optional. HuggingFace Inference API (free tier available). Only used when
# EMBEDDINGS_PROVIDER=huggingface (or hf). Prefixes and pooling are handled by
# the model; dimensions are discovered at runtime.
HF_API_KEY=
HF_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# --- Reddit source (Phase 2) ---
# Create a Reddit app at https://www.reddit.com/prefs/apps (type "script" or
# "web") to get a client id/secret. Required only to use the Reddit source;
# Hacker News remains the zero-config default.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# User-Agent Reddit expects, e.g. "faindageeg/0.1 by u/yourname".
REDDIT_USER_AGENT=

# --- Inbound (push) ingestion ---
# A long random shared secret that senders (n8n/IFTTT automations) pass in the
# X-Webhook-Secret header to POST normalized records to /ingest/webhook. Leave
# blank to disable inbound ingestion.
INGEST_WEBHOOK_SECRET=

# --- Google Sheets buffer source ---
# A Google Sheet "published to the web" CSV URL (File > Share > Publish to web,
# then pick CSV). Only used by the Google Sheets source. The sheet is expected
# to have the header columns: externalId,url,title,content,author,publishedAt.
# Each run drains the whole sheet; downstream dedup by externalId prevents
# reprocessing. Leave blank to disable the source.
GOOGLE_SHEETS_CSV_URL=
