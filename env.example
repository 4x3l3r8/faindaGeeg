# ---------------------------------------------------------------------------
# Tech Opportunity Intelligence System (faindaGeeg)
# Copy this file to `.env` and fill in values as needed:
#   cp env.example .env
# ---------------------------------------------------------------------------

# --- Database (matches the `db` service in docker-compose.yml) ---
DATABASE_URL=postgresql://faindageeg:faindageeg@localhost:5432/faindageeg

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
# Optional single-user guard. Leave blank to run open (no auth).
API_AUTH_TOKEN=

# --- Web ---
WEB_PORT=5173
# Base URL the dashboard uses to reach the API. Vite exposes VITE_* vars to the
# client; the web app falls back to this value when unset.
VITE_API_BASE_URL=http://localhost:3001

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- AI / LLM (Phase 1) ---
AI_PROVIDER=openrouter
# Leave blank for now; not required until Phase 1.
OPENROUTER_API_KEY=
# Cheap default model id.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Embeddings provider (Phase 4). Leave blank (default) to use the built-in local
# hashing embedder, which needs no API key and works fully offline.
EMBEDDINGS_PROVIDER=
# Optional. Enables higher-quality embeddings via OpenAI text-embedding-3-small
# (256 dims). Only used when EMBEDDINGS_PROVIDER=openai. The default is a
# built-in local embedder needing no key.
OPENAI_API_KEY=

# --- Reddit source (Phase 2) ---
# Create a Reddit app at https://www.reddit.com/prefs/apps (type "script" or
# "web") to get a client id/secret. Required only to use the Reddit source;
# Hacker News remains the zero-config default.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# User-Agent Reddit expects, e.g. "faindageeg/0.1 by u/yourname".
REDDIT_USER_AGENT=
